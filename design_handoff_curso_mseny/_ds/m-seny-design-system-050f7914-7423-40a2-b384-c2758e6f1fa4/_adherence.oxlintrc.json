{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque Variable|Instrument Sans Variable|Chivo Mono Variable))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque Variable, Instrument Sans Variable, Chivo Mono Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|arrow|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, arrow, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|ghost|ink)$/]",
        "message": "<Button> variant must be one of 'accent' | 'ghost' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|ctaLabel|ctaHref|layout|onCta|style|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: title, sub, ctaLabel, ctaHref, layout, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:center|split)$/]",
        "message": "<CtaBand> layout must be one of 'center' | 'split'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|brackets|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: on, brackets, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:light|dark|muted)$/]",
        "message": "<Eyebrow> on must be one of 'light' | 'dark' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: q, a, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkLive'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|style|key|ref|className|style|children)$/]",
        "message": "<LinkLive> doesn't accept that prop. Declared props: href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:subBrand|size|on|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: subBrand, size, on, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='subBrand'] > Literal[value!=/^(?:studio|academy|labs|forge)$/]",
        "message": "<Logo> subBrand must be one of 'studio' | 'academy' | 'labs' | 'forge'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Logo> on must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMarquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|label|speed|style|key|ref|className|style|children)$/]",
        "message": "<LogoMarquee> doesn't accept that prop. Declared props: logos, label, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|desc|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OptionCard> doesn't accept that prop. Declared props: name, desc, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<PillarIcon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:consultoria|formacion|automatizacion|software)$/]",
        "message": "<PillarIcon> name must be one of 'consultoria' | 'formacion' | 'automatizacion' | 'software'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|name|desc|done|fill|style|key|ref|className|style|children)$/]",
        "message": "<ProcessCard> doesn't accept that prop. Declared props: num, name, desc, done, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, options, value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|total|stepLabel|ofLabel|style|key|ref|className|style|children)$/]",
        "message": "<StepProgress> doesn't accept that prop. Declared props: step, total, stepLabel, ofLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|optional|optionalLabel|multiline|rows|value|onChange|placeholder|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, optional, optionalLabel, multiline, rows, value, onChange, placeholder, type, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "CtaBand": {
        "replaces": []
      },
      "Eyebrow": {
        "replaces": []
