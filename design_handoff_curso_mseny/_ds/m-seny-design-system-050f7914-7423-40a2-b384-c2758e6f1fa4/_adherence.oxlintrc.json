    "tokens": [
      "--border-default",
      "--border-on-dark",
      "--color-accent",
      "--color-accent-deep",
      "--color-accent-ink",
      "--color-ink",
      "--color-ink-soft",
      "--color-line",
      "--color-line-dark",
      "--color-mist",
      "--color-muted",
      "--color-paper",
