      "--text-base-leading",
      "--text-base-size",
      "--text-body",
      "--text-muted",
      "--text-muted-on-dark",
      "--text-on-accent",
      "--text-on-dark"
    ],
    "tokenKinds": {
      "--color-ink": "color",
      "--color-ink-soft": "color",
      "--color-paper": "color",
      "--color-paper-dim": "color",
      "--color-accent": "color",
      "--color-accent-deep": "color",
      "--color-accent-ink": "color",
      "--color-muted": "color",
      "--color-mist": "color",
      "--color-line": "color",
      "--color-line-dark": "color",
      "--surface-page": "color",
      "--surface-page-dim": "color",
      "--surface-dark": "color",
      "--surface-accent": "color",
      "--text-body": "font",
      "--text-muted": "font",
      "--text-on-dark": "font",
      "--text-muted-on-dark": "font",
      "--text-on-accent": "font",
      "--border-default": "color",
      "--border-on-dark": "color",
      "--font-display": "font",
      "--font-body": "font",
      "--font-mono": "font",
      "--text-base-size": "font",
      "--text-base-leading": "font",
      "--display-weight": "font",
